# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!infra/docker-compose.yml # Keep config files, but exclude .env
infra/.env
infra/userlist.txt
infra/kubernetes/base/acp-secret.yaml
ui/.env.local
**/secrets/**
# The `secrets/` TF module is legitimate Terraform code (random_password +
# aws_secretsmanager_secret resources — no cred VALUES). Whitelist it so
# the broad **/secrets/** rule above doesn't hide it from CI.
!infra/terraform/modules/secrets/
!infra/terraform/modules/secrets/**
**/*.pem
**/*.key
**/*.pub
**/*.cert

# Private operator notes — NOT for public GitBook.
# Reasons:
#   client01.md       contains demo credentials
#   ops_metrics.md    contains SSH key paths + EC2 IPs + RDS internal hostname
#   SECRETS.md        filename alone is a red flag; superseded by docs/security/secret-management.md
#   docs/quickstart.md  superseded by docs/introduction/quickstart.md
#   CLIENT.md         operator/customer walkthrough — contains demo credentials
docs/client01.md
docs/ops_metrics.md
docs/SECRETS.md
docs/quickstart.md
CLIENT.md

# ==========================================
# Session audit + ops artifacts
# ==========================================
# Anything generated under audit_*/, FIXES_*.md, or similar one-shot session
# dirs is *operational evidence*, not product source. These often contain
# OpenAPI dumps, probe results, hit counts, JWT lengths, demo passwords,
# and account ids — fine for the operator's working tree, NOT for git.
audit_*/
# The `audit_kms/` TF module is legitimate infra code, not a session-audit
# dir. Whitelist it so the audit_*/ rule above doesn't hide it from CI.
!infra/terraform/modules/audit_kms/
!infra/terraform/modules/audit_kms/**
FIXES_APPLIED.md
HONEST_STATUS_*.md
DEPLOY_REPORT_*.md
SPRINT_*_REPORT.md
SOAK_REPORT_*.md
session_*/
# Ignore every direct child of reports/ — historical CSVs, JSON dumps,
# soak outputs, etc. v2.0 production load-test evidence is committed
# per SPRINT.md §7 D3; re-include that one directory and let Git walk
# into it, then re-exclude any dated sub-directories within (which hold
# raw locust CSVs the SRE produces during a run).
reports/*
!reports/load-test-2026-Q3/
reports/load-test-2026-Q3/*/
brutal_*.md
debug_*.txt

# ==========================================
# AWS / cloud one-off credential files
# Sprint A8 — defensive: catch every common .env.* shape so a future
# .env.aws.staging / .env.aws.prod / .env.ci.local can't slip past
# the per-folder .gitignore in voice-agent/.
# ==========================================
**/.env.aws*
**/.env.ci*
**/.env.staging*
**/.env.prod*
**/.env.production*
**/.env.dev*
**/.env.test*
**/.env.local*
**/aws_credentials
**/.aws/credentials
**/.aws/config

# ==========================================
# Secrets toolchain — never commit a real .pypirc / .npmrc with tokens
# ==========================================
.pypirc
**/.pypirc
.npmrc
**/.npmrc
.gem/credentials

